{
  "name": "web-recorder-ts",
  "version": "1.0.0",
  "scripts": {
    "test": "npx playwright test",
    "record": "cd .. && mvn exec:java",
    "codegen": "npx playwright codegen",
    "report:allure": "npx allure generate allure-results --clean -o reports/allure-report && npx allure open reports/allure-report",
    "report:html": "npx playwright show-report reports/html-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^26.6.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.12.2",
    "typescript": "^5.0.0"
  }
}
